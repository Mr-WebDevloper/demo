# PostgreSQL via Docker Compose (preferred):
# DATABASE_URL=postgres://analytics:analytics@localhost:5432/analytics
# Embedded PGlite (works without Docker; still PostgreSQL SQL):
DATABASE_URL=pglite://./data/pglite
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics

# API
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Ingest write key (browser SDK + server tracker)
WRITE_KEY=dev-write-key-change-me

# Dashboard query key
DASHBOARD_KEY=dev-dashboard-key-change-me

# Restaurant Vite apps
VITE_API_BASE_URL=http://localhost:4000
VITE_WRITE_KEY=dev-write-key-change-me
VITE_DASHBOARD_KEY=dev-dashboard-key-change-me
